<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="py-4" id="orderDetailPage" data-order-id="<%= orderId %>">
  <div class="container">

    <nav aria-label="breadcrumb" class="mb-3 no-print">
      <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/orders">My Orders</a></li>
        <li class="breadcrumb-item active" aria-current="page">Order Details</li>
      </ol>
    </nav>

    <!-- Loading -->
    <div id="orderPageLoading">
      <div class="skeleton" style="height: 400px;"></div>
    </div>

    <!-- Not found -->
    <div id="orderPageNotFound" class="empty-state d-none">
      <i class="bi bi-exclamation-circle"></i>
      <h5 class="mt-3">Order Not Found</h5>
      <p class="mb-3">This order doesn't exist or you don't have permission to view it.</p>
      <a href="/orders" class="btn btn-primary">Back to My Orders</a>
    </div>

    <!-- Content -->
    <div id="orderPageContent" class="d-none">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h3 class="mb-1">Order <span id="pageOrderNumber"></span></h3>
          <p class="text-muted small mb-0">Placed on <span id="pageOrderDate"></span></p>
        </div>
        <div class="d-flex gap-2 no-print">
          <span class="badge order-status-badge" id="pageStatusBadge"></span>
          <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
          </button>
        </div>
      </div>

      <div class="row g-4">
        <!-- Left: Items + Timeline -->
        <div class="col-lg-8">
          <div class="card mb-4">
            <div class="card-body">
              <h6 class="mb-3">Order Items</h6>
              <div id="pageOrderItems"></div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <h6 class="mb-3">Order Timeline</h6>
              <div class="order-timeline" id="pageOrderTimeline"></div>
            </div>
          </div>
        </div>

        <!-- Right: Summary + Address + Actions -->
        <div class="col-lg-4">
          <div class="card mb-4">
            <div class="card-body">
              <h6 class="mb-3">Payment Summary</h6>
              <div class="d-flex justify-content-between small mb-2">
                <span class="text-muted">Subtotal</span>
                <span id="pageItemsPrice">৳0.00</span>
              </div>
              <div class="d-flex justify-content-between small mb-2 text-success d-none" id="pageDiscountRow">
                <span>Discount <span id="pageCouponCode"></span></span>
                <span id="pageDiscountAmount">-৳0.00</span>
              </div>
              <div class="d-flex justify-content-between small mb-2">
                <span class="text-muted">Shipping</span>
                <span id="pageShippingPrice">৳0.00</span>
              </div>
              <hr />
              <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                <span>Total</span>
                <span id="pageTotalPrice">৳0.00</span>
              </div>
              <div class="small">
                <span class="text-muted">Payment Method:</span> <strong>Cash on Delivery</strong><br/>
                <span class="text-muted">Payment Status:</span> <strong id="pagePaymentStatus"></strong>
              </div>
            </div>
          </div>

          <div class="card mb-4">
            <div class="card-body">
              <h6 class="mb-3">Shipping Address</h6>
              <div class="small" id="pageShippingAddress"></div>
            </div>
          </div>

          <div id="pageOrderActions" class="d-grid gap-2 no-print"></div>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>

<script src="/js/orders.js"></script>