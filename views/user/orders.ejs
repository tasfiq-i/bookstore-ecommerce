<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="py-4">
  <div class="container">

    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">My Orders</li>
      </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="mb-0">My Orders</h3>
      <span class="small text-muted">
        <span class="live-status-dot" id="liveStatusDot"></span><span id="liveStatusText">Connecting...</span>
      </span>
    </div>

    <!-- Status filter tabs -->
    <ul class="nav nav-pills mb-4 flex-wrap gap-1" id="orderStatusTabs">
      <li class="nav-item"><button class="nav-link active" data-status="">All</button></li>
      <li class="nav-item"><button class="nav-link" data-status="pending">Pending</button></li>
      <li class="nav-item"><button class="nav-link" data-status="confirmed">Confirmed</button></li>
      <li class="nav-item"><button class="nav-link" data-status="processing">Processing</button></li>
      <li class="nav-item"><button class="nav-link" data-status="shipped">Shipped</button></li>
      <li class="nav-item"><button class="nav-link" data-status="delivered">Delivered</button></li>
      <li class="nav-item"><button class="nav-link" data-status="cancelled">Cancelled</button></li>
    </ul>

    <!-- Loading -->
    <div id="ordersLoadingState">
      <div class="skeleton mb-3" style="height: 110px;"></div>
      <div class="skeleton" style="height: 110px;"></div>
    </div>

    <!-- Empty -->
    <div id="ordersEmptyState" class="empty-state d-none">
      <i class="bi bi-bag-x"></i>
      <h5 class="mt-3">No orders yet</h5>
      <p class="mb-3">When you place an order, it will show up here.</p>
      <a href="/books" class="btn btn-primary">Start Shopping</a>
    </div>

    <!-- Order List -->
    <div id="ordersList" class="d-none"></div>

    <!-- Pagination -->
    <nav class="mt-4" aria-label="Orders pagination">
      <ul class="pagination justify-content-center" id="ordersPagination"></ul>
    </nav>

  </div>
</main>

<!-- Order Quick-View Modal -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Order Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="orderModalBody">
        <div class="text-center py-5">
          <div class="spinner-border text-primary"></div>
        </div>
      </div>
      <div class="modal-footer">
        <a href="#" id="viewFullOrderBtn" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-box-arrow-up-right me-1"></i> Open Full Page
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script src="/js/orders.js"></script>