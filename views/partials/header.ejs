<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | BookStore' : 'BookStore' %></title>
  <meta name="description" content="BookStore — discover, buy, and enjoy books online with fast delivery and real-time stock updates." />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png" />

  <!-- Bootstrap 5 CSS -->
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha512-jnSuA4Ss2PkkikSOLtYs8BlYIeeIK1h99ty4YfvRPAlzr377vr3CXDb7sb7eEEBYjDtcYj+AjBH3FLv5uSJuXg=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
    integrity="sha512-o0ZI3ZLllHFH8j5Kfe6WvJ+iH1JB8ZUWZBK8/gWvvUp2nUJnHy0lqOWKh1jaTctzGKZ7X4Kbz8XmSk5EqWSXqA=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap" rel="stylesheet" />

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Page-specific extra CSS hook -->
  <% if (typeof extraCss !== 'undefined') { %>
    <%- extraCss %>
  <% } %>
</head>
<body>

  <!-- Global Toast Container (Bootstrap 5 Toasts render here, injected via JS) -->
  <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

  <!-- Global Page Loader (shown during AJAX navigation/actions if needed) -->
  <div id="globalLoader" class="global-loader d-none">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>