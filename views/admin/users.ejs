<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="admin-layout" id="adminGuard" style="display: none;">
  <%- include('../partials/admin-sidebar', { activePage: 'users' }) %>

  <main class="admin-content">
    <div class="admin-topbar">
      <div>
        <button class="btn btn-outline-secondary btn-sm d-lg-none me-2" id="openAdminSidebarBtn"><i class="bi bi-list"></i></button>
        <h4 class="d-inline-block mb-0">Manage Users</h4>
        <p class="text-muted small mb-0 mt-1">View, promote, deactivate, or remove customer and admin accounts</p>
      </div>
    </div>

    <div class="admin-table-card">
      <div class="admin-table-toolbar">
        <div class="d-flex gap-2 flex-wrap">
          <input type="search" class="form-control form-control-sm" id="usersSearchInput" placeholder="Search name or email..." style="width: 220px;" />
          <select class="form-select form-select-sm" id="usersRoleFilter" style="width: 140px;">
            <option value="">All Roles</option>
            <option value="admin">Admin</option>
            <option value="customer">Customer</option>
          </select>
          <select class="form-select form-select-sm" id="usersStatusFilter" style="width: 140px;">
            <option value="">All Status</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </div>
        <select class="form-select form-select-sm" id="usersLimitSelect" style="width: 100px;">
          <option value="10">10 / page</option>
          <option value="20" selected>20 / page</option>
          <option value="50">50 / page</option>
        </select>
      </div>

      <div class="table-responsive">
        <table class="table admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Joined</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <tr><td colspan="6" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center p-3 border-top">
        <span class="small text-muted" id="usersResultsInfo"></span>
        <nav><ul class="pagination pagination-sm mb-0" id="usersPagination"></ul></nav>
      </div>
    </div>
  </main>
</div>

<div id="adminAccessDenied" class="container py-5 text-center d-none">
  <i class="bi bi-shield-lock display-1 text-danger"></i>
  <h4 class="mt-3">Access Denied</h4>
  <a href="/" class="btn btn-primary mt-2">Back to Home</a>
</div>

<!-- User Details Modal -->
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">User Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="userDetailModalBody">
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Change User Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editRoleUserId" />
        <p class="mb-2">Updating role for: <strong id="editRoleUserName"></strong></p>
        <label class="form-label">Role</label>
        <select class="form-select" id="editRoleSelect">
          <option value="customer">Customer</option>
          <option value="admin">Admin</option>
        </select>
        <div class="alert alert-warning small mt-3 mb-0" id="editRoleWarning">
          <i class="bi bi-exclamation-triangle me-1"></i>
          Promoting a user to Admin grants them full access to the admin dashboard, including order management, catalog editing, and other user accounts.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmRoleChangeBtn">Save Role</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/admin.js"></script>
<script src="/js/admin-users.js"></script>